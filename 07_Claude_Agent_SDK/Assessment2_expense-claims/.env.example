# Copy to .env and fill in. .env is git-ignored: never commit a real key.
#   cp .env.example .env
#
# The Agent SDK reads the key from the process environment; expense_app/config.py
# loads this file with python-dotenv. If ANTHROPIC_API_KEY is not set, the SDK's
# bundled Claude Code CLI falls back to an existing `claude` login on this machine.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional settings (defaults shown)
# EXPENSE_MODEL=claude-opus-5-5
# EXPENSE_EFFORT=medium            # low | medium | high | xhigh | max
# EXPENSE_MAX_TURNS=30             # per agent run
# EXPENSE_MAX_BUDGET_USD=1.00      # per agent run
# EXPENSE_WORKSPACE=               # where inbox/, outbox/, state/ live (default: project folder)
