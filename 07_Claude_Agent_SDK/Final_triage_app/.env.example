# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your key:
#
#   cp .env.example .env
#
# Get a key from https://platform.claude.com/  ->  API Keys
#
# IMPORTANT: the Agent SDK reads the key from the *process environment*.
# It does NOT parse .env files by itself. Every example in this course calls
# `load_dotenv()` first, which copies these values into os.environ.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: pin a model for the whole course so results are reproducible.
# Leave blank to use the SDK default.
# COURSE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Optional: LangSmith tracing for the triage_app (https://smith.langchain.com
# -> Settings -> API Keys). Set LANGSMITH_TRACING=true to turn it on.
# Add LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com for the EU region.
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGSMITH_PROJECT=triage-app
# LANGSMITH_AGENT_ENVIRONMENT=local
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# Optional: third-party model providers (pick at most one).
# See the quickstart for the matching credential setup.
# ---------------------------------------------------------------------------
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
# CLAUDE_CODE_USE_FOUNDRY=1